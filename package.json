{
  "name": "izgetour",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured yet\" && exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:affiliate": "tsx src/db/seed-affiliate.ts",
    "db:fix:adana": "tsx src/db/fix-adana.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/fetchRoutes.ts",
    "ci": "npm run lint && npm run typecheck && npm run build",
    "postinstall": "grep -q \"if (value == null) return false;\" node_modules/next/dist/esm/lib/client-and-server-references.js || sed -i \"s/export function isServerReference(value) {/export function isServerReference(value) {\\n    if (value == null) return false;/\" node_modules/next/dist/esm/lib/client-and-server-references.js; grep -q \"if (value == null) return false;\" node_modules/next/dist/lib/client-and-server-references.js || sed -i \"/function isServerReference(value) {/a\\    if (value == null) return false;\" node_modules/next/dist/lib/client-and-server-references.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@swc/helpers": "^0.5.21",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "i18next": "^26.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-intl": "^4.11.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "patch-package": "^8.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.7",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "source-map": "^0.7.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
